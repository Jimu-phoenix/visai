# Server-only — used by src/app/api/chat/route.js. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Server-only — used by src/lib/supabaseAdmin.js. Never prefix with NEXT_PUBLIC_.
# Supabase's "secret key" (formerly service_role). It bypasses RLS and must
# never be sent to the browser.
SUPABASE_SECRET_KEY=
META_MUSE_GLIMMER_30b=

# Browser-only — used by @supabase/supabase-js in src/lib/supabaseClient.js
# for the realtime presence channel. The publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
